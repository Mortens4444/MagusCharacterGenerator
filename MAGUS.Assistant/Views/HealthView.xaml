<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAGUS.Assistant.ViewModels"
             xmlns:mc="clr-namespace:Mtf.Maui.Controls;assembly=Mtf.Maui.Controls"
             xmlns:mv="clr-namespace:MAGUS.Assistant.Views"
             xmlns:t="clr-namespace:MAGUS.Things;assembly=MAGUS"
             x:Class="MAGUS.Assistant.Views.HealthView"
             x:ClassModifier="internal"
             x:DataType="vm:CharacterViewModel">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Health & Pain Resistance -->
            <Border Style="{StaticResource BoxBorder}">
                <VerticalStackLayout Margin="16">
                    <Label Text="Health &amp; Pain Resistance" Style="{StaticResource HeaderLabel}"/>
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto">
                        <mc:EntryWithLabel Label="Max. HP" Text="{Binding MaxHealthPoints}" IsReadOnly="True" WidthRequest="100" Grid.ColumnSpan="2" />
                        <mc:EntryWithLabel Label="Max. PRP" Text="{Binding MaxPainTolerancePoints}" IsReadOnly="True" WidthRequest="100" Grid.Row="1" Grid.Column="0" />
                        <mc:EntryWithLabel Label="Max. PRP/level" Text="{Binding PainToleranceModifierFormula}" IsReadOnly="True" WidthRequest="100" Grid.Row="1" Grid.Column="1" />
                        <mc:EntryWithLabel Label="Deaths" Text="{Binding DeathCount}" IsReadOnly="True" WidthRequest="100" Grid.Row="2" Grid.Column="0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
