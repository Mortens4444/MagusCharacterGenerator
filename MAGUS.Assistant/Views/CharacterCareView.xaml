<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAGUS.Assistant.ViewModels"
             xmlns:mcconv="clr-namespace:Mtf.Maui.Controls.Converters;assembly=Mtf.Maui.Controls"
             x:Class="MAGUS.Assistant.Views.CharacterCareView"
             x:ClassModifier="internal"
             x:DataType="vm:CharacterViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <mcconv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Hunger -->
            <Border Style="{StaticResource BoxBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Hunger" Style="{StaticResource HeaderLabel}"/>
                    <Label Text="{Binding HungerPercent, StringFormat='{0:F0}%'}" FontSize="20">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHungerCritical}" Value="True">
                                <Setter Property="TextColor" Value="#FF3B30" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Critically hungry - eating or a healing spell is urgent." TextColor="#FF3B30" IsVisible="{Binding IsHungerCritical}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Sleep -->
            <Border Style="{StaticResource BoxBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Rest" Style="{StaticResource HeaderLabel}"/>
                    <Label Text="{Binding SleepPercent, StringFormat='{0:F0}%'}" FontSize="20">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSleepCritical}" Value="True">
                                <Setter Property="TextColor" Value="#FF3B30" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Critically sleep-deprived - sleeping or a healing spell is urgent." TextColor="#FF3B30" IsVisible="{Binding IsSleepCritical}" FontSize="12" />
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsSleeping}">
                        <Label Text="Asleep - progress resolves over real time, even with the app closed." FontSize="12" FontAttributes="Italic" />
                        <ProgressBar Progress="{Binding SleepProgress}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Care actions -->
            <Border Style="{StaticResource BoxBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Care" Style="{StaticResource HeaderLabel}"/>
                    <Button Text="Sleep" Command="{Binding SleepCommand}" IsVisible="{Binding IsSleeping, Converter={StaticResource InverseBooleanConverter}}" />
                    <Button Text="Eat" Command="{Binding EatCommand}" />
                    <Button Text="Use healing item" Command="{Binding UseHealingItemCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
