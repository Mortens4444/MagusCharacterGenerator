<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAGUS.Assistant.ViewModels"
             xmlns:mcconv="clr-namespace:Mtf.Maui.Controls.Converters;assembly=Mtf.Maui.Controls"
             xmlns:converters="clr-namespace:MAGUS.Assistant.Converters"
             x:Class="MAGUS.Assistant.Views.CharacterCareView"
             x:ClassModifier="internal"
             x:DataType="vm:CharacterViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <mcconv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:LiteralTranslationConverter x:Key="LiteralTranslationConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Death -->
            <Border Style="{StaticResource BoxBorder}" IsVisible="{Binding IsDead}" Stroke="#FF3B30">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Dead" Style="{StaticResource HeaderLabel}" TextColor="#FF3B30" />
                    <Label Text="{Binding ., Converter={StaticResource LiteralTranslationConverter}, ConverterParameter='This character has died - no action is possible until another character revives them with an item that resurrects (e.g. Water of Life).'}" TextColor="#FF3B30" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Hunger -->
            <Border Style="{StaticResource BoxBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Hunger" Style="{StaticResource HeaderLabel}"/>
                    <Label Text="{Binding HungerPercent, StringFormat='{0:F0}%'}" FontSize="20">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHungerCritical}" Value="True">
                                <Setter Property="TextColor" Value="#FF3B30" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding ., Converter={StaticResource LiteralTranslationConverter}, ConverterParameter='Critically hungry - eating or a healing spell is urgent.'}" TextColor="#FF3B30" IsVisible="{Binding IsHungerCritical}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Sleep -->
            <Border Style="{StaticResource BoxBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Rest" Style="{StaticResource HeaderLabel}"/>
                    <Label Text="{Binding SleepPercent, StringFormat='{0:F0}%'}" FontSize="20">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSleepCritical}" Value="True">
                                <Setter Property="TextColor" Value="#FF3B30" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding ., Converter={StaticResource LiteralTranslationConverter}, ConverterParameter='Critically sleep-deprived - sleeping or a healing spell is urgent.'}" TextColor="#FF3B30" IsVisible="{Binding IsSleepCritical}" FontSize="12" />
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsSleeping}">
                        <Label Text="{Binding ., Converter={StaticResource LiteralTranslationConverter}, ConverterParameter='Asleep - progress resolves over real time, even with the app closed.'}" FontSize="12" FontAttributes="Italic" />
                        <ProgressBar Progress="{Binding SleepProgress}" />
                        <Button Text="Stop sleeping"
                                Command="{Binding StopSleepCommand}"
                                ToolTipProperties.Text="Wake up early - restoration is prorated to however long you actually slept" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Care actions -->
            <Border Style="{StaticResource BoxBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Care" Style="{StaticResource HeaderLabel}"/>
                    <Button Text="Sleep" Command="{Binding SleepCommand}" IsVisible="{Binding IsSleeping, Converter={StaticResource InverseBooleanConverter}}" />
                    <Button Text="Eat" Command="{Binding EatCommand}" />
                    <Button Text="Use healing item" Command="{Binding UseHealingItemCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
