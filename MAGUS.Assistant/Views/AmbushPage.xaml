<?xml version="1.0" encoding="utf-8" ?>
<v:NotifierPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:v="clr-namespace:Mtf.LanguageService.MAUI.Views;assembly=Mtf.LanguageService.MAUI"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MAGUS.Assistant.ViewModels"
                x:Class="MAGUS.Assistant.Views.AmbushPage"
                x:ClassModifier="internal"
                x:DataType="vm:AmbushViewModel"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Padding="24" RowSpacing="12">

        <Label Grid.Row="0" Text="Ambushed!" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#FF3B30" />

        <Image x:Name="CreatureImage" Grid.Row="1" Source="{Binding CreatureImage}" Aspect="AspectFit" MaximumHeightRequest="260" VerticalOptions="Center" />

        <Label Grid.Row="2" Text="{Binding CreatureName}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />

        <Label x:Name="MessageLabel"
               Grid.Row="3"
               Text="{Binding Message}"
               FontSize="16"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

        <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0,8,0,0">
            <Button Grid.Column="0" Text="⚔️ Fight" Command="{Binding FightCommand}" BackgroundColor="#FF3B30" TextColor="White" HeightRequest="52" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="🏃 Flee" Command="{Binding FleeCommand}" BackgroundColor="{StaticResource Primary}" TextColor="Black" HeightRequest="52" FontAttributes="Bold" />
        </Grid>

    </Grid>

</v:NotifierPage>
